-- spi_master.vhd
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity spi_master is
  generic (
    G_CLK_HZ     : natural := 100_000_000; -- частота системного такту
    G_SPI_HZ     : natural := 10_000_000;  -- бажана частота SCK
    G_FRAME_BITS : positive := 8;          -- довжина слова
    G_CPOL       : integer := 0;           -- 0 або 1
    G_CPHA       : integer := 0;           -- 0 або 1
    G_LSB_FIRST  : boolean := false        -- MSB першим за замовчуванням
  );
  port (
    clk     : in  std_logic;
    rst_n   : in  std_logic;

    -- керування/дані
    start   : in  std_logic;
    tx_data : in  std_logic_vector(G_FRAME_BITS-1 downto 0);
    rx_data : out std_logic_vector(G_FRAME_BITS-1 downto 0);
    busy    : out std_logic;
    done    : out std_logic;

    -- SPI лінії
    sck     : out std_logic;
    mosi    : out std_logic;
    miso    : in  std_logic;
    cs_n    : out std_logic
  );
end entity;

architecture rtl of spi_master is
  constant C_DIV : natural := integer(G_CLK_HZ / (2 * G_SPI_HZ)); 
  -- 2 тики дільника = 1 період SCK (тому множник 2)

  type t_state is (IDLE, LOAD, ASSERT_CS, TRANSFER, DEASSERT_CS, DONE);
  signal st, st_n : t_state;

  signal div_cnt  : natural range 0 to C_DIV-1 := 0;
  signal sck_i    : std_logic := '0';  -- сирий SCK до поляризації
  signal sck_out  : std_logic := '0';  -- з урахуванням CPOL
  signal sck_en   : std_logic := '0';  -- “тік” дільника (toggle точка)

  signal cs_n_i   : std_logic := '1';

  signal sh_tx    : std_logic_vector(G_FRAME_BITS-1 downto 0);
  signal sh_rx    : std_logic_vector(G_FRAME_BITS-1 downto 0);
  signal bit_cnt  : integer range 0 to G_FRAME_BITS := 0;

  signal busy_i   : std_logic := '0';
  signal done_i   : std_logic := '0';
  signal mosi_i   : std_logic := '0';

  -- допоміжні: визначення leading/trailing відносно CPOL
  function is_leading_edge(sck_now, cpol : std_logic) return boolean is
  begin
    -- leading = перехід від idle-рівня (CPOL) до !CPOL
    return (cpol = '0' and sck_now = '1') or (cpol = '1' and sck_now = '0');
  end function;

  function is_trailing_edge(sck_now, cpol : std_logic) return boolean is
  begin
    -- trailing = перехід назад до idle-рівня (CPOL)
    return (cpol = '0' and sck_now = '0') or (cpol = '1' and sck_now = '1');
  end function;

  signal cpol_s, cpha_s : std_logic;
begin
  cpol_s <= '1' when G_CPOL /= 0 else '0';
  cpha_s <= '1' when G_CPHA /= 0 else '0';

  -- виходи
  sck   <= sck_out;
  cs_n  <= cs_n_i;
  mosi  <= mosi_i;
  rx_data <= sh_rx;
  busy  <= busy_i;
  done  <= done_i;

  -- Генерація SCK: дільник + поляризація
  process(clk, rst_n)
  begin
    if rst_n = '0' then
      div_cnt <= 0;
      sck_i   <= '0';
      sck_en  <= '0';
    elsif rising_edge(clk) then
      if st = TRANSFER then
        if div_cnt = C_DIV-1 then
          div_cnt <= 0;
          sck_i   <= not sck_i; -- toggle
          sck_en  <= '1';
        else
          div_cnt <= div_cnt + 1;
          sck_en  <= '0';
        end if;
      else
        -- поза TRANSFER тримаємо SCK у idle стані
        div_cnt <= 0;
        sck_i   <= '0';
        sck_en  <= '0';
      end if;
    end if;
  end process;

  -- Поляризований SCK (idle рівень = CPOL)
  sck_out <= (sck_i xor cpol_s);

  -- FSM: послідовність станів
  process(clk, rst_n)
  begin
    if rst_n = '0' then
      st <= IDLE;
    elsif rising_edge(clk) then
      st <= st_n;
    end if;
  end process;

  process(all)
  begin
    st_n   <= st;
    case st is
      when IDLE       => if start = '1' then st_n <= LOAD; end if;
      when LOAD       => st_n <= ASSERT_CS;
      when ASSERT_CS  => st_n <= TRANSFER;
      when TRANSFER   => if bit_cnt = 0 and done_i = '1' then st_n <= DEASSERT_CS; end if;
      when DEASSERT_CS=> st_n <= DONE;
      when DONE       => st_n <= IDLE;
      when others     => st_n <= IDLE;
    end case;
  end process;

  -- Основна логіка передачі/прийому
  process(clk, rst_n)
    variable leading, trailing : boolean;
  begin
    if rst_n = '0' then
      cs_n_i  <= '1';
      busy_i  <= '0';
      done_i  <= '0';
      mosi_i  <= '0';
      sh_tx   <= (others => '0');
      sh_rx   <= (others => '0');
      bit_cnt <= 0;
    elsif rising_edge(clk) then
      done_i <= '0'; -- однотактний імпульс

      case st is
        when IDLE =>
          cs_n_i <= '1';
          busy_i <= '0';
          mosi_i <= (others => '0')(0);
          bit_cnt<= 0;

        when LOAD =>
          busy_i <= '1';
          -- підготовка shift-регістрів
          if G_LSB_FIRST then
            sh_tx <= tx_data; -- LSB перший (зсув вправо)
          else
            sh_tx <= tx_data; -- MSB перший (зсув вліво)
          end if;

        when ASSERT_CS =>
          cs_n_i <= '0';
          -- Якщо CPHA=0, на першому sempl’і потрібно виставити початковий MOSI до першого активного фронту
          if cpha_s = '0' then
            if G_LSB_FIRST then
              mosi_i <= sh_tx(0);
            else
              mosi_i <= sh_tx(G_FRAME_BITS-1);
            end if;
          end if;
          -- ініціалізація лічильника бітів
          bit_cnt <= G_FRAME_BITS;

        when TRANSFER =>
          -- Обробляємо тільки у моменти toggle SCK (sck_en='1')
          if sck_en = '1' then
            leading  := is_leading_edge(sck_out, cpol_s);
            trailing := is_trailing_edge(sck_out, cpol_s);

            if cpha_s = '0' then
              -- CPHA=0: семпл на leading, зсув на trailing
              if leading then
                -- семпл MISO у шину RX
                if G_LSB_FIRST then
                  sh_rx <= miso & sh_rx(G_FRAME_BITS-1 downto 1);
                else
                  sh_rx <= sh_rx(G_FRAME_BITS-2 downto 0) & miso;
                end if;
              end if;

              if trailing then
                -- зсув TX і виставлення наступного біта на MOSI
                if bit_cnt > 0 then
                  if G_LSB_FIRST then
                    mosi_i <= sh_tx(1);
                    sh_tx  <= '0' & sh_tx(G_FRAME_BITS-1 downto 1);
                  else
                    mosi_i <= sh_tx(G_FRAME_BITS-2);
                    sh_tx  <= sh_tx(G_FRAME_BITS-2 downto 0) & '0';
                  end if;

                  bit_cnt <= bit_cnt - 1;
                  if bit_cnt = 1 then
                    done_i <= '1'; -- останній біт щойно відіслали
                  end if;
                end if;
              end if;

            else
              -- CPHA=1: зсув на leading, семпл на trailing
              if leading then
                if bit_cnt > 0 then
                  if G_LSB_FIRST then
                    mosi_i <= sh_tx(0);
                    sh_tx  <= '0' & sh_tx(G_FRAME_BITS-1 downto 1);
                  else
                    mosi_i <= sh_tx(G_FRAME_BITS-1);
                    sh_tx  <= sh_tx(G_FRAME_BITS-2 downto 0) & '0';
                  end if;

                  bit_cnt <= bit_cnt - 1;
                  if bit_cnt = 1 then
                    done_i <= '1';
                  end if;
                end if;
              end if;

              if trailing then
                if G_LSB_FIRST then
                  sh_rx <= miso & sh_rx(G_FRAME_BITS-1 downto 1);
                else
                  sh_rx <= sh_rx(G_FRAME_BITS-2 downto 0) & miso;
                end if;
              end if;
            end if;
          end if;

        when DEASSERT_CS =>
          cs_n_i <= '1';

        when DONE =>
          busy_i <= '0';
          done_i <= '1';

        when others => null;
      end case;
    end if;
  end process;

end architecture;
